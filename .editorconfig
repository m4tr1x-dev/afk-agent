root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,markdown}]
indent_size = 2
# Markdown uses two trailing spaces for hard breaks in some renderers.
trim_trailing_whitespace = false

[*.{yml,yaml,json,jsonc,toml}]
indent_size = 2

[*.rs]
indent_size = 4

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{ps1,sh}]
indent_size = 2
