# Rust
/target/
**/*.rs.bk
*.pdb

# .NET
[Bb]in/
[Oo]bj/
.vs/
*.user
*.suo
artifacts/

# Documentation build
/site/
/.lycheecache
# Vale style packages are downloaded by `vale sync`, not vendored.
# Our own rules live in styles/AfkAgent and styles/config and ARE tracked.
/styles/Microsoft/
/docs/requirements.lock
.cache/
__pycache__/
.venv/

# Model weights — never commit these, they are downloaded at first run
/models/
*.gguf
*.safetensors

# Env / secrets
.env
.env.*
!.env.example

# Agent harness
# The portable settings are tracked; machine-specific paths are not.
.claude/settings.local.json
.claude/worktrees/
# The build journal lives on the orphan `agent-status` branch, checked out
# here as a worktree. Tracking it from main would put every journal write in
# a pull request diff.
/.agent/

# Editors / OS
.vscode/
.idea/
Thumbs.db
desktop.ini
.DS_Store

# Runtime output
logs/
*.log
recordings/
screenshots/
captures/
